# API
# Port for the local Express API server.
PORT=4000
# Comma-separated production origins. Leave empty for local development.
CORS_ORIGIN=

# Optional OTLP endpoint. When set, the API exports HTTP and future database traces.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=cargoiq-api

# Web
# Leave empty for Vite's development proxy. Set this only when serving the web
# app against a separately deployed API.
VITE_API_BASE_URL=
